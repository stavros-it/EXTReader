<ui:FluentWindow x:Class="EXTReader.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EXT File Browser"
        Width="1000" Height="680"
        MinWidth="720" MinHeight="480"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding SourceName, StringFormat='EXT Browser — {0}'}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8,16,8">
            <ui:Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Extract File…"
                       Command="{Binding ExtractCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Content="Extract Folder…"
                       Command="{Binding ExtractDirectoryCommand}"
                       Appearance="Primary" Margin="0,0,8,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="16,6">
            <TextBlock Text="{Binding CurrentPath}" FontFamily="Consolas"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>

        <Grid Grid.Row="3" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedItem}"
                      MouseDoubleClick="FileList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size"
                                        DisplayMemberBinding="{Binding SizeFormatted}"
                                        Width="90" />
                        <GridViewColumn Header="Modified"
                                        DisplayMemberBinding="{Binding ModifiedFormatted}"
                                        Width="140" />
                        <GridViewColumn Header="Permissions"
                                        DisplayMemberBinding="{Binding Permissions}"
                                        Width="110" />
                        <GridViewColumn Header="Type"
                                        DisplayMemberBinding="{Binding TypeLabel}"
                                        Width="80" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <ui:Card Grid.Column="2" VerticalAlignment="Stretch">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Properties"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="Name:" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="2" Text="{Binding SelectedItem.Name, FallbackValue='—'}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Text="Inode:" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="4" Text="{Binding SelectedItem.Inode, FallbackValue='—'}"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Text="Size:" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="6"
                               Text="{Binding SelectedItem.SizeFormatted, FallbackValue='—'}"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="7" Text="Modified:" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="8"
                               Text="{Binding SelectedItem.ModifiedFormatted, FallbackValue='—'}"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="9" Text="Permissions:" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="10"
                               Text="{Binding SelectedItem.Permissions, FallbackValue='—'}"
                               FontFamily="Consolas" Margin="0,0,0,8" />

                    <StackPanel Grid.Row="11">
                        <TextBlock FontWeight="SemiBold" Text="Type:" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedItem.TypeLabel, FallbackValue='—'}" Margin="0,0,0,8" />

                        <TextBlock FontWeight="SemiBold" Text="UID / GID:" Margin="0,0,0,2" />
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="{Binding SelectedItem.Uid, FallbackValue='—'}" />
                            <Run Text=" / " />
                            <Run Text="{Binding SelectedItem.Gid, FallbackValue='—'}" />
                        </TextBlock>

                        <TextBlock FontWeight="SemiBold" Text="Links:" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedItem.LinksCount, FallbackValue='—'}"
                                   Margin="0,0,0,8" />

                        <TextBlock FontWeight="SemiBold" Text="Blocks:" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedItem.BlockCount, FallbackValue='—'}"
                                   Margin="0,0,0,8" />

                        <TextBlock FontWeight="SemiBold" Text="Flags:" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedItem.Flags, FallbackValue='—', StringFormat='0x{0:X8}'}"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</ui:FluentWindow>
