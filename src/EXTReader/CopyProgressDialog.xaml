<ui:FluentWindow x:Class="EXTReader.CopyProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Copying files"
        Width="560" Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Copying files" />

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock Text="{Binding CurrentFile, FallbackValue='Preparing…'}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,12" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Minimum="0" Maximum="100"
                             Value="{Binding Percent}" Height="18" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Percent, StringFormat={}{0:F1}%}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{Binding Summary, FallbackValue=''}"
                       FontSize="11" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="24,8,24,16">
            <ui:Button Content="Cancel"
                       Click="Cancel_Click"
                       Appearance="Caution" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
