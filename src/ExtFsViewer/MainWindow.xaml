<ui:FluentWindow x:Class="ExtFsViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="EXT FS Viewer"
        Width="920" Height="620"
        MinWidth="720" MinHeight="480"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="EXT FS Viewer" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8,16,8">
            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}"
                       Appearance="Primary" Margin="0,0,8,0" />
            <ui:Button Content="Open Image…" Command="{Binding OpenImageCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Content="Browse…" Command="{Binding BrowseCommand}"
                       Appearance="Primary" Margin="0,0,8,0" />
            <ui:Button Content="Restart as Admin" Command="{Binding RestartElevatedCommand}"
                       Margin="0,0,8,0">
                <ui:Button.Style>
                    <Style TargetType="ui:Button">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding SelectedSource}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Source"
                                        DisplayMemberBinding="{Binding DisplayName}"
                                        Width="340" />
                        <GridViewColumn Header="FS"
                                        DisplayMemberBinding="{Binding FileSystem}"
                                        Width="70" />
                        <GridViewColumn Header="Size"
                                        DisplayMemberBinding="{Binding SizeFormatted}"
                                        Width="100" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <ui:Card Grid.Column="2" VerticalAlignment="Stretch">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Source Details"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="Name:"
                               FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedSource.DisplayName, FallbackValue='—'}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Text="Path:"
                               FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="4"
                               Text="{Binding SelectedSource.BackingPath, FallbackValue='—'}"
                               TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />

                    <StackPanel Grid.Row="5" Margin="0,12,0,0">
                        <TextBlock FontWeight="SemiBold" Text="Filesystem:" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedSource.FileSystem, FallbackValue='—'}" />

                        <TextBlock FontWeight="SemiBold" Text="Size:" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding SelectedSource.SizeFormatted, FallbackValue='—'}" />

                        <TextBlock FontWeight="SemiBold" Text="Offset:" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding SelectedSource.Offset, FallbackValue='—', StringFormat='0 bytes'}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</ui:FluentWindow>
